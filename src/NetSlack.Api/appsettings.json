{
  "ConnectionStrings": {
    "NetSlack": "Data Source=netslack.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "NetSlack",
    "Audience": "NetSlack.Client",
    "SigningKey": "replace-this-development-key-with-secret-manager",
    "ExpirationMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

